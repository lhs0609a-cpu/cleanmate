{
  "name": "teraclean",
  "version": "0.0.1",
  "private": true,
  "description": "확실한 건 알아서, 애매한 것만 딱 물어보는 정리 도구 — 엔진 프로토타입",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "scan": "node --experimental-strip-types --no-warnings src/cli.ts",
    "probe": "node --experimental-strip-types --no-warnings src/cli-probe.ts",
    "clean": "node --experimental-strip-types --no-warnings src/cli-clean.ts",
    "restore": "node --experimental-strip-types --no-warnings src/cli-restore.ts",
    "test": "node --experimental-strip-types --no-warnings --test src/**/*.test.ts",
    "dev": "vite",
    "build": "npm run guide && npm run check:library && node scripts/build-design-preview.mjs && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "release:prep": "node scripts/publish-release.mjs",
    "stats:downloads": "node scripts/download-counts.mjs",
    "guide": "node --experimental-strip-types --no-warnings scripts/build-guide.mjs",
    "assets:visuals": "node --experimental-strip-types --no-warnings scripts/make-visuals.mjs",
    "check:visuals": "node scripts/check-visuals.mjs",
    "check:library": "node scripts/check-library.mjs",
    "check:library:full": "node --max-old-space-size=4096 scripts/check-library.mjs --full"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2",
    "esbuild": "^0.24.0",
    "sharp": "^0.35.4",
    "vite": "^7.1.5"
  }
}
